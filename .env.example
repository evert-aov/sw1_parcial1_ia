# Configuración propia de FastAPI. Copiar a ia/.env y completar los secretos.
# El token interno debe coincidir con AI_SERVICE_TOKEN de NestJS, nunca con JWT_SECRET.
AI_SERVICE_TOKEN=replace-with-a-shared-random-service-token
MONGODB_URI=mongodb://USERNAME:PASSWORD@127.0.0.1:27017/uml_studio_db?authSource=admin
MONGODB_DATABASE=uml_studio_db
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_OLLAMA_MODEL=qwen3.8:latest
CHAT_DEFAULT_PROVIDER=ollama
CHAT_MEDIA_PROVIDER=vertex
CHAT_TIMEOUT_SECONDS=300
CHAT_CONTEXT_CHARS=48000
# Memoria por sala: mensajes recientes, bloques resumidos y recuperación textual antigua.
CHAT_RECENT_MESSAGES=12
CHAT_MEMORY_BATCH_MESSAGES=12
CHAT_RETRIEVAL_MESSAGES=4
CHAT_MEMORY_TIMEOUT_SECONDS=20
GCP_PROJECT_ID=your-google-cloud-project
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Live reutiliza GEMINI_API_KEY y el cliente Google configurado para el chat.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Charon
GEMINI_LIVE_SESSION_SECONDS=600
GEMINI_LIVE_MAX_SESSIONS=4
GEMINI_API_KEY=
# Si se usa ADC en lugar de una clave, configurar GOOGLE_APPLICATION_CREDENTIALS
# en el entorno del proceso con la ruta al archivo de credenciales de Google.

# Síntesis de respuestas (Edge TTS remoto, sin clave adicional).
SPEECH_TIMEOUT_SECONDS=30
SPEECH_MAX_CHARS=12000
SPEECH_MAX_CONCURRENT=2
SPEECH_CACHE_DAYS=7
